{
    "mcps": [
        {
            "id": "desktop-automation",
            "name": "Desktop Automation",
            "description": "Control mouse, keyboard, windows, and take screenshots",
            "command": "npx -y @anthropic/mcp-desktop",
            "platforms": [
                "windows",
                "darwin"
            ],
            "category": "system",
            "recommended": true,
            "tools_provided": [
                "click",
                "type_text",
                "screenshot",
                "get_windows",
                "focus_window"
            ]
        },
        {
            "id": "filesystem",
            "name": "Filesystem",
            "description": "Read and write files with configurable access",
            "command": "npx -y @modelcontextprotocol/server-filesystem .",
            "platforms": [
                "windows",
                "darwin"
            ],
            "category": "filesystem",
            "recommended": true,
            "config_schema": {
                "allowed_paths": {
                    "type": "array",
                    "description": "Paths the MCP can access"
                }
            }
        },
        {
            "id": "fetch",
            "name": "Web Fetch",
            "description": "Fetch web content for LLM consumption",
            "command": "npx -y @modelcontextprotocol/server-fetch",
            "platforms": [
                "windows",
                "darwin"
            ],
            "category": "web",
            "recommended": false
        },
        {
            "id": "memory",
            "name": "Memory (Knowledge Graph)",
            "description": "Persistent memory using knowledge graph",
            "command": "npx -y @modelcontextprotocol/server-memory",
            "platforms": [
                "windows",
                "darwin"
            ],
            "category": "memory",
            "recommended": false
        },
        {
            "id": "github",
            "name": "GitHub",
            "description": "Interact with GitHub repositories, issues, and pull requests",
            "command": "npx -y @modelcontextprotocol/server-github",
            "platforms": [
                "windows",
                "darwin"
            ],
            "category": "development",
            "recommended": true,
            "config_schema": {
                "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": {
                        "label": "Personal Access Token",
                        "description": "Create at github.com/settings/tokens",
                        "type": "string",
                        "required": true,
                        "secret": true
                    }
                },
                "validation": {
                    "tool": "search_repositories",
                    "args": {
                        "query": "test-auth-validation"
                    }
                }
            }
        }
    ]
}