# OpenAI API Key (Required for Cloud LLM & TTS)
OPENAI_API_KEY=sk-...

# ElevenLabs (Optional - Recommended for high quality voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=fUjY9K2nAIwlALOwSiwc
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Deepgram (Optional - For faster STT)
DEEPGRAM_API_KEY=

# Audio Settings
MIC_INDEX=0

# ═══════════════════════════════════════════════════
# LLM Provider & Model Configuration
# ═══════════════════════════════════════════════════

# Default LLM provider: "openai", "ollama", "lmstudio"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Ollama Settings (for locally deployed models)
# Make sure Ollama is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ═══════════════════════════════════════════════════
# Three-Tier Cognitive Architecture
# ═══════════════════════════════════════════════════
# Mode: "three_tier" or "classic"
BRAIN_MODE=three_tier

# Tier 1: Router — Intent classification (fast/small model recommended)
ROUTER_PROVIDER=openai
ROUTER_MODEL=gpt-4o-mini

# Tier 2: Worker — Task execution (most capable model)
WORKER_PROVIDER=openai
WORKER_MODEL=gpt-4o-mini

# Tier 3: Synthesizer — Personality formatting (lightweight model)
SYNTHESIZER_PROVIDER=openai
SYNTHESIZER_MODEL=gpt-4o-mini

# Example: Mixed local + cloud configuration
# ROUTER_PROVIDER=ollama
# ROUTER_MODEL=llama3
# WORKER_PROVIDER=openai
# WORKER_MODEL=gpt-4o
# SYNTHESIZER_PROVIDER=ollama
# SYNTHESIZER_MODEL=llama3
